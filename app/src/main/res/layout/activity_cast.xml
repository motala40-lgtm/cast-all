<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_sky">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: dark navy rounded card with logo + wordmark on the
                 left and the settings / language / cast circle buttons on
                 the right, per the supplied design reference. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toolbar_navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_easycast" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textColor="@color/toolbar_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_circle_settings"
                    android:contentDescription="@string/settings_button"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <ImageButton
                    android:id="@+id/languageButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_control_circle_language"
                    android:contentDescription="@string/language_selection"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_globe" />

                <androidx.mediarouter.app.MediaRouteButton
                    android:id="@+id/castButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_control_circle_cast"
                    android:padding="8dp"
                    app:mediaRouteButtonTint="@color/toolbar_text"
                    android:contentDescription="@string/open_cast_chooser" />

            </LinearLayout>

            <!-- Wi-Fi note -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:text="@string/same_wifi"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Sleep timer banner: only visible while a timer is actively
                 counting down, so the user doesn't have to open Settings
                 just to check how much time is left. -->
            <LinearLayout
                android:id="@+id/sleepTimerBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sleep_timer_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/sleep_timer_accent" />

                <TextView
                    android:id="@+id/sleepTimerBannerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/sleep_timer_off"
                    android:textColor="@color/sleep_timer_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sleepTimerBannerCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="@string/sleep_timer_cancel"
                    android:textColor="@color/sleep_timer_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Connection status: compact row, no heavy panel. A small spinner
                 shows while searching; a colored dot shows once resolved.
                 Hidden per user request (kept in layout so MainActivity's
                 findViewById/visibility calls keep working safely). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/statusSpinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/primary_blue"
                    android:visibility="gone" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_neutral" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="@string/not_connected"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Now Playing card: hidden until a session is actively casting media -->
            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_now_playing_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/playingOnText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/now_playing"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/nowPlayingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/mediaSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingHorizontal="0dp"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@drawable/seekbar_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/currentTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="00:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/totalTimeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="00:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Transport controls: rewind 10s / play-pause / forward 10s -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/rewindButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_control_circle"
                            android:contentDescription="@string/content_desc_rewind"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_replay10" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-10s"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="26dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/playPauseButton"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:background="@drawable/bg_control_circle_accent"
                            android:contentDescription="@string/content_desc_play"
                            android:padding="20dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_play" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/forwardButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_control_circle"
                            android:contentDescription="@string/content_desc_forward"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:scaleX="-1"
                            android:src="@drawable/ic_replay10" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="+10s"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Volume control for the target device -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_volume"
                        android:contentDescription="@string/volume_control" />

                    <SeekBar
                        android:id="@+id/volumeSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:max="100"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:thumb="@drawable/seekbar_thumb" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_volume"
                        android:contentDescription="@string/volume_control" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: cast source -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="10dp"
                android:text="@string/cast_from"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08" />

            <!-- Local video / mirror (row 1), photo / music (row 2) — all equal weight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/localVideoButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_video"
                    android:drawableStart="@drawable/ic_video_camera"
                    android:drawableTint="@color/video_mint_icon"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/local_video"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/playlistButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_playlist"
                    android:drawableStart="@drawable/ic_playlist"
                    android:drawableTint="@color/playlist_sky_icon"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/playlist_button"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/castPhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_photo"
                    android:drawableStart="@drawable/ic_photo"
                    android:drawableTint="@color/photo_peach_icon"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/cast_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/castMusicButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card_music"
                    android:drawableStart="@drawable/ic_music"
                    android:drawableTint="@color/music_lavender_icon"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/cast_music"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Advanced: cast from a direct URL — collapsed by default since
                 this is a power-user feature used far less than the local
                 media buttons above; tucked away here instead of competing
                 with Local Video for attention. -->
            <LinearLayout
                android:id="@+id/urlCastHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_link"
                    app:tint="@color/primary_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/cast_from_url_header"
                    android:textColor="@color/primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/urlCastChevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urlCastContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Video URL input: minimal box below the buttons -->
                <EditText
                    android:id="@+id/videoUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_link"
                    android:drawablePadding="10dp"
                    android:hint="@string/video_url_hint"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint" />

                <!-- Cast video (primary action) -->
                <Button
                    android:id="@+id/castVideoButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="@string/cast_video"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big logo highlight: a bold, prominent brand moment near the
                 bottom of the scroll content (replaces the earlier ad-slot
                 placeholder — no ads here, just the logo). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_easycast" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed footer: prominent device-selection button, always reachable
         without scrolling. Its label switches to "Connected to: X" once a
         device is active. Support link lives here too, always visible. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sky_gradient_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <Button
            android:id="@+id/selectDeviceButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_tv_device"
            android:drawablePadding="10dp"
            android:text="@string/select_device_button"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
